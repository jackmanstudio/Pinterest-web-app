# Copy to .env.local for local development. Never commit real values.

# --- Supabase (Phase 1: auth + database). Leave empty to run in Demo mode. ---
# The URL and anon key are public by design; row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Not used yet (Phase 3+ token storage / admin jobs).
SUPABASE_SERVICE_ROLE_KEY=

# --- Text AI (server only). Leave empty to use labelled demo templates. ---
TEXT_AI_PROVIDER=anthropic
TEXT_AI_API_KEY=
# Optional. Defaults to claude-opus-5-5. claude-haiku-5-5 is much cheaper.
TEXT_AI_MODEL=

# --- Image AI (server only). With no credentials, images are labelled DEMO placeholders. ---
# Option A, FREE: Cloudflare Workers AI (FLUX.2 klein 4B, about 60 free images a day).
#   dash.cloudflare.com > Workers AI > "Use REST API": copy the Account ID and create an API token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Option B, PAID, recommended (good quality, about $0.011 per pin): fal.ai key (fal.ai > Dashboard > Keys).
#   Premium models via IMAGE_AI_MODEL: fal-ai/nano-banana-2 (~$0.067) or blackforestlabs/flux-3/text-to-image (~$0.07).
FAL_KEY=
# Option C, PAID alternative: your OpenAI API key (platform.openai.com > API keys).
IMAGE_AI_API_KEY=
# Optional. fal | cloudflare | openai | demo. Empty = fal, then Cloudflare, then OpenAI, whichever is set; else demo.
IMAGE_AI_PROVIDER=
# Optional model override. Defaults: blackforestlabs/flux-3/klein/text-to-image (fal),
#   @cf/black-forest-labs/flux-2-klein-4b (Cloudflare), gpt-image-1.5 (OpenAI).
IMAGE_AI_MODEL=
# Optional, OpenAI only. low | medium (default) | high.
IMAGE_AI_QUALITY=
# Optional. Override the estimated USD cost per image used for the budget cap (defaults: fal by model, Cloudflare 0, OpenAI by quality).
IMAGE_AI_COST_PER_IMAGE_USD=

# --- Cost control ---
# Paid AI calls are refused once this month's estimated spend reaches this (USD). Default 10.
AI_MONTHLY_BUDGET_USD=10

# --- Pinterest API v5 (server only) ---
# Needs Supabase + SUPABASE_SERVICE_ROLE_KEY too, so tokens are stored server-side.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Must match the redirect URI registered in the Pinterest developer portal EXACTLY.
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback
# sandbox (Trial access, default) or production (needs Standard access)
PINTEREST_ENV=sandbox
# Optional. Defaults to read-only: user_accounts:read,boards:read,pins:read
PINTEREST_SCOPES=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Phase 4: set to true to also request boards:write + pins:write (needed to publish).
# Reconnect each workspace after changing this.
PINTEREST_ENABLE_PUBLISHING=false
# Secret for the scheduled-publish endpoint (/api/cron/publish-due).
CRON_SECRET=
