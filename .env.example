# Copy to .env.local for local development. Never commit real values.

# --- Supabase (Phase 1: auth + database). Leave empty to run in Demo mode. ---
# The URL and anon key are public by design; row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Not used yet (Phase 3+ token storage / admin jobs).
SUPABASE_SERVICE_ROLE_KEY=

# --- Text AI (server only). Leave empty to use labelled demo templates. ---
TEXT_AI_PROVIDER=anthropic
TEXT_AI_API_KEY=
# Optional. Defaults to claude-opus-5-5. claude-haiku-5-5 is much cheaper.
TEXT_AI_MODEL=

# --- Image AI (server only). No real adapter yet: leave empty for labelled demo placeholders. ---
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=

# --- Cost control ---
# Paid AI calls are refused once this month's estimated spend reaches this (USD). Default 10.
AI_MONTHLY_BUDGET_USD=10

# --- Pinterest API v5 (server only) ---
# Needs Supabase + SUPABASE_SERVICE_ROLE_KEY too, so tokens are stored server-side.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Must match the redirect URI registered in the Pinterest developer portal EXACTLY.
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback
# sandbox (Trial access, default) or production (needs Standard access)
PINTEREST_ENV=sandbox
# Optional. Defaults to read-only: user_accounts:read,boards:read,pins:read
PINTEREST_SCOPES=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Phase 4: set to true to also request boards:write + pins:write (needed to publish).
# Reconnect each workspace after changing this.
PINTEREST_ENABLE_PUBLISHING=false
# Secret for the scheduled-publish endpoint (/api/cron/publish-due).
CRON_SECRET=
